function AnalyticsScreen({onBack}){
  const [period,setPeriod]=useState("7D");
  const [metric,setMetric]=useState("profit");
  const [chartType,setChartType]=useState("area");
  const periods=["1D","7D","1M","3M","1Y"];
  const data=CHART_DATA[period];
  const metrics=[
    {key:"sales",label:"Pool Sales",color:C.black,value:data.reduce((a,d)=>a+d.sales,0)},
    {key:"profit",label:"Profit Shared",color:C.gold,value:data.reduce((a,d)=>a+d.profit,0)},
    {key:"contributions",label:"Contributions",color:C.green,value:data.reduce((a,d)=>a+d.contributions,0)},
  ];
  const am=metrics.find(m=>m.key===metric);

  const renderChart=()=>{
    const props={data,margin:{top:5,right:0,left:0,bottom:0}};
    const common={type:"monotone",dataKey:metric,stroke:am.color,strokeWidth:2.5,dot:false};
    if(chartType==="bar") return(<BarChart {...props}><CartesianGrid strokeDasharray="3 3" stroke={C.border} vertical={false}/><XAxis dataKey="t" tick={{fontSize:9,fill:C.muted,fontFamily:"'DM Mono',monospace"}} axisLine={false} tickLine={false}/><YAxis tickFormatter={v=>fmtK(v)} tick={{fontSize:9,fill:C.muted,fontFamily:"'DM Mono',monospace"}} axisLine={false} tickLine={false} width={38}/><Tooltip content={<ChartTip/>}/><Bar dataKey={metric} fill={am.color} radius={[4,4,0,0]} name={am.label}/></BarChart>);
    if(chartType==="line") return(<LineChart {...props}><CartesianGrid strokeDasharray="3 3" stroke={C.border} vertical={false}/><XAxis dataKey="t" tick={{fontSize:9,fill:C.muted,fontFamily:"'DM Mono',monospace"}} axisLine={false} tickLine={false}/><YAxis tickFormatter={v=>fmtK(v)} tick={{fontSize:9,fill:C.muted,fontFamily:"'DM Mono',monospace"}} axisLine={false} tickLine={false} width={38}/><Tooltip content={<ChartTip/>}/><Line {...common} activeDot={{r:4}}/></LineChart>);
    return(<AreaChart {...props}><defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="5%" stopColor={am.color} stopOpacity={0.15}/><stop offset="95%" stopColor={am.color} stopOpacity={0}/></linearGradient></defs><CartesianGrid strokeDasharray="3 3" stroke={C.border} vertical={false}/><XAxis dataKey="t" tick={{fontSize:9,fill:C.muted,fontFamily:"'DM Mono',monospace"}} axisLine={false} tickLine={false}/><YAxis tickFormatter={v=>fmtK(v)} tick={{fontSize:9,fill:C.muted,fontFamily:"'DM Mono',monospace"}} axisLine={false} tickLine={false} width={38}/><Tooltip content={<ChartTip/>}/><Area {...common} fill="url(#ag)" name={am.label}/></AreaChart>);
  };

  return(
    <div style={{minHeight:"100vh",background:C.white,fontFamily:"'Barlow',sans-serif",paddingBottom:40}}>
      <div style={{padding:"14px 16px",borderBottom:`1px solid ${C.border}`,display:"flex",alignItems:"center",gap:10,position:"sticky",top:0,background:C.white,zIndex:10}}>
        <button onClick={onBack} style={{width:32,height:32,borderRadius:8,background:C.light,border:"none",cursor:"pointer",fontSize:13,display:"flex",alignItems:"center",justifyContent:"center"}}>←</button>
        <div><Logo size={14}/><div style={{fontSize:8,color:C.muted,letterSpacing:1.5,textTransform:"uppercase",fontFamily:"'Barlow Condensed',sans-serif"}}>Pool Analytics</div></div>
      </div>
      <div style={{padding:"16px 16px 0"}}>
        <div style={{display:"flex",background:C.light,borderRadius:10,padding:3,marginBottom:16}}>
          {periods.map(p=><button key={p} onClick={()=>setPeriod(p)} style={{flex:1,padding:"8px 4px",borderRadius:8,border:"none",background:period===p?C.black:"transparent",color:period===p?C.white:C.muted,fontSize:11,fontWeight:period===p?800:500,cursor:"pointer",fontFamily:"'Barlow Condensed',sans-serif",letterSpacing:0.5,transition:"all 0.2s"}}>{p}</button>)}
        </div>
        <div style={{display:"flex",gap:8,marginBottom:16}}>
